# Set to 1 only after the selected Sanity identity provider/SSO policy has
# mandatory MFA enabled for every invited administrator and editor.
ADMIN_MFA_ENFORCED=0
SANITY_REVALIDATE_SECRET=

# RFQ delivery: private Vercel Blob, verified Resend sender, persistent rate limit.
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
RFQ_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
